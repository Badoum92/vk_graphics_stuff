#include "global.glsl"

BUFFER(uniform_buffer)
{
    mat4 mvp;
    uint width;
    uint height;
};

PUSH_CONSTANT(push_constant)
{
    uniform_buffer ubo;
    uint image_index;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    uvec2 uv = GOBAL_INVOCATION_ID.xy;
    imageStore(image2D_rgba8[image_index], ivec2(uv), vec4(uv.x / float(ubo.width), uv.y / float(ubo.height), 0, 1));
}
