#include "global.glsl"
#include "raytrace.glsl"

struct vox_matl
{
    uint color;
    uint type;
    float rough;
    float metal;
    float specular;
    float emit;
    float flux;
    float ior;
    float trans;
};

BUFFER(materials_buffer)
{
    vox_matl materials;
};

BUFFER(uniform_buffer)
{
    mat4 inv_view_proj;
    vec4 position;
};

PUSH_CONSTANT(push_constant)
{
    uniform_buffer ubo;
    materials_buffer mat;
    uvec2 resolution;
    uint frame;
    uint output_image;
    uint voxels_index;
};

